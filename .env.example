# Copy this file to .env and put your real keys in .env.
# .env is git-ignored. Never put real keys in this file.

# Anthropic API key, from the Anthropic Console (API Keys page)
ANTHROPIC_API_KEY=your-anthropic-key-here

# OpenAI API key, from the OpenAI Platform (API keys page)
OPENAI_API_KEY=your-openai-key-here
